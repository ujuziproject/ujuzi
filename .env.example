# uJuzi environment variables
#
# On Cloudflare Pages, set these under: your project -> Settings -> Variables and Secrets.
# Add them to BOTH the Production and Preview environments.
#
# SUPABASE_URL and SUPABASE_ANON_KEY are used twice:
#   - at build time, baked into the front end (they are public by design)
#   - at run time, by the /api functions to check who is logged in
SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"

# Gemini API key from https://aistudio.google.com/apikey
# On Cloudflare, add this one as an encrypted Secret (not plain text).
GEMINI_API_KEY="your-gemini-key"

# Optional: override the Gemini model (default: gemini-3.6-flash)
# GEMINI_MODEL="gemini-3.6-flash"

# For local development, put these in a file named .dev.vars (for `wrangler pages dev`)
# and .env.local (for `vite`). Both are git-ignored.
